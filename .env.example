# ---- required in production ---------------------------------------------------------------------
# Static bearer token every agent presents as `Authorization: Bearer <RELAY_TOKEN>`.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If unset, the server generates a temporary token at boot and prints it (dev only).
RELAY_TOKEN=change-me-32-chars-minimum-please

# Public base URL of this hub, no trailing slash. Rendered into /connect and /openapi.json.
# On Railway you can omit this: the server falls back to https://$RAILWAY_PUBLIC_DOMAIN automatically.
# Set it explicitly only for a custom domain or a non-Railway host.
PUBLIC_URL=https://your-app.up.railway.app

# The person these agents act for.
OWNER_HANDLE=@manish

# ---- optional -------------------------------------------------------------------------------------
# Where the JSON store lives. On Railway mount a volume at /data so it survives redeploys.
DATA_FILE=/data/store.json

# Comma-separated names of the owner's agents, seeded into the store on first boot.
OWNER_AGENTS=muse,claude-code,codex,cursor

# Per-agent tokens (optional). Any of these also authenticates, and tells the hub which agent is calling.
# RELAY_AGENT_TOKENS=muse:token-for-muse,claude-code:token-for-claude

# Webhook that receives a JSON POST whenever an *urgent* verb is queued (Slack/Discord/ntfy style).
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/relay

# Link shown on /invite for peers who want to self-host their own hub.
# REPO_URL=https://github.com/<you>/relay-agent-hub

# Extra directories of verb plugins (colon-separated), loaded after src/verbs.
# RELAY_VERB_DIRS=/data/verbs

# Injected by Railway. Only set locally.
# PORT=3000
